# Переменные окружения Paperless Assistant.
# Комментарии стоят на отдельных строках, над переменной.
# Пустое значение означает «взять значение по умолчанию из assistant/config.py».
# Секреты здесь всегда пустые: настоящие значения живут только в .env, а он в .gitignore.

# --- Ассистент ---
# anthropic | openai | gigachat | yandexgpt | local
LLM_PROVIDER=anthropic
# точная версия модели
LLM_MODEL=
LLM_API_KEY=
# модель Voyage AI: voyage-4 | voyage-4-large | voyage-4-lite
EMBEDDING_MODEL=voyage-4
# ключ из dash.voyageai.com → API Keys
VOYAGE_API_KEY=
# адрес под ключ: dash.voyageai.com — https://api.voyageai.com/v1,
# MongoDB Atlas → AI Model APIs — https://ai.mongodb.com/v1
VOYAGE_API_URL=https://api.voyageai.com/v1
# адрес Qdrant с хоста; контейнеру ассистента compose задаёт http://qdrant:6333 сам
QDRANT_URL=http://localhost:6333
# куда скачиваются исходники форка; дерево тега лежит в <путь>/<PAPERLESS_REF>/
PAPERLESS_SOURCE_PATH=data/paperless-src
# тег релиза, по которому строится индекс
PAPERLESS_REF=v3.4.2
# форк, на который ведут ссылки в ответах
PAPERLESS_REPO_URL=https://github.com/MichaelZhdanov/paperless-ngx-rag
# адрес API Paperless для ассистента (с хоста); не PAPERLESS_URL, так называется переменная самого Paperless
PAPERLESS_API_URL=http://localhost:8000
# токен отдельного пользователя только на чтение
PAPERLESS_TOKEN=
TELEGRAM_BOT_TOKEN=
ESCALATION_CHAT_ID=
# id через запятую с ролью «инженер», остальные — «пользователь»
ENGINEER_TELEGRAM_IDS=
LOG_LEVEL=INFO

# --- Demo-экземпляр Paperless (ассистент эти переменные не получает) ---
# секрет и пароль генерирует make up при создании .env (scripts/init_env.py)
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
