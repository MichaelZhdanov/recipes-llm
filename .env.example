# Переменные окружения Recipes LLM.
# Комментарии стоят на отдельных строках, над переменной.
# Пустое значение означает «взять значение по умолчанию из assistant/config.py».
# Секреты здесь всегда пустые: настоящие значения живут только в .env, а он в .gitignore.

# --- Ассистент ---
# провайдер LLM ассистента: anthropic (по умолчанию, выбран по eval этапа 2) | gigachat;
# судьи eval — всегда GigaChat-3-Ultra, поэтому GIGACHAT_API_KEY нужен и с anthropic
LLM_PROVIDER=anthropic
# пусто — модель провайдера по умолчанию (assistant/generation/llm.py);
# anthropic: claude-haiku-5-5 (по умолчанию) | claude-sonnet-5-5 | claude-opus-5-5;
# gigachat: GigaChat-2-Pro | GigaChat-2-Max | GigaChat-2
LLM_MODEL=
# только anthropic: сколько модель думает — low | medium | high | xhigh | max
LLM_EFFORT=medium
# ключ авторизации GigaChat: developers.sber.ru → проект GigaChat API →
# Настройки API → Получить ключ (это Base64 от Client ID:Client Secret)
GIGACHAT_API_KEY=
# область доступа: GIGACHAT_API_PERS — физлица (Freemium) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# ключ API Anthropic: platform.claude.com → API keys (подписка Claude ключа не даёт)
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1
# провайдер эмбеддингов: cloudru | voyage
EMBEDDING_PROVIDER=cloudru
# пусто — модель провайдера по умолчанию (assistant/retrieval/embeddings.py);
# cloudru: ai-sage/Giga-Embeddings-instruct-3B | ai-sage/Giga-Embeddings-instruct-480M |
# BAAI/bge-m3 | Qwen/Qwen3-Embedding-0.6B; voyage: voyage-4 | voyage-4-large | voyage-4-lite
EMBEDDING_MODEL=
# дописывать ли к вопросу задачу у instruct-моделей (Giga-Embeddings): 1 | 0;
# 0 — по итогам сравнения моделей (evals/reports/2026-11-05-models.md)
EMBEDDING_QUERY_INSTRUCTION=0
# API-ключ сервисного аккаунта уровня «Проект» (console.cloud.ru → Сервисные
# аккаунты → API-ключи, сервис Foundation Models); пара Key ID/Key Secret не подходит
CLOUD_RU_API_KEY=
CLOUD_RU_API_URL=https://foundation-models.api.cloud.ru/v1
# ключ из dash.voyageai.com → API Keys
VOYAGE_API_KEY=
# адрес под ключ: dash.voyageai.com — https://api.voyageai.com/v1,
# MongoDB Atlas → AI Model APIs — https://ai.mongodb.com/v1
VOYAGE_API_URL=https://api.voyageai.com/v1
# адрес Qdrant с хоста; контейнеру ассистента compose задаёт http://qdrant:6333 сам
QDRANT_URL=http://localhost:6333
# ревизия (коммит) датасета rogozinushka/povarenok-recipes на HuggingFace,
# по ней строится индекс
DATASET_REVISION=ffaf49ee7439afe6dbf0653714ceacb9b57ff830
# куда скачивается датасет (make data); файл ревизии лежит в <путь>/<DATASET_REVISION>/
DATA_PATH=data/recipes
# индекс на выборке из N рецептов (make index и деплой); пусто — весь датасет
INDEX_SAMPLE=
TELEGRAM_BOT_TOKEN=
ESCALATION_CHAT_ID=
LOG_LEVEL=INFO

# --- Docker Compose ---
# порт HTTP API ассистента на хосте (http://localhost:<порт>/docs)
ASSISTANT_PORT=8080
