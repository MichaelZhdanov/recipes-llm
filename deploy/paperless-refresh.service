# Раз в сутки: исходники Paperless на теге и индекс, если их ещё нет (deploy/refresh.sh).
[Unit]
Description=Paperless Assistant: исходники Paperless и индекс
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Деплой и таймер идут от root (решение автора): тот же владелец файлов, что у deploy.sh.
User=root
WorkingDirectory=/opt/paperless-assistant
ExecStart=/opt/paperless-assistant/deploy/refresh.sh
