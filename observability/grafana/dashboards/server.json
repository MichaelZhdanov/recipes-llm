        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.+|docker.+|br-.+\"}[5m])) * 8",
